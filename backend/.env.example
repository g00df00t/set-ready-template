SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret
ANTHROPIC_API_KEY=sk-ant-...
SENDGRID_API_KEY=SG....
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
SUPPORT_EMAIL=you@yourdomain.com                  # where "Need help?" form submissions are sent (defaults to support@set-ready-set.com)
APP_BASE_URL=http://localhost:3000

# Master Access (operator usage view at /master). Comma-separated auth user ids.
# Fails closed: unset or empty means nobody can reach it, including you.
# Find yours in Supabase > Authentication > Users. Differs per project.
OWNER_USER_IDS=

# Optional: regex for additional allowed CORS origins (Vercel previews get a new
# hostname per push, so a fixed CORS_ORIGINS list only ever covers one of them).
# Matched with re.fullmatch — escape the dots. Empty disables it.
# CORS_ORIGIN_REGEX=https://frontend-[a-z0-9-]+-your-vercel-account\.vercel\.app

# Which call sheet renderer to use: "template" (instant, from a Jinja
# template) or "model" (the original ~97s Claude prompt). Defaults to model.
CALL_SHEET_RENDERER=template
