<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<style>
  @page { size: letter landscape; margin: 0.5in; }
  body { font-family: system-ui, -apple-system, Arial, sans-serif; color: #1a1a1a; font-size: 9.5pt; }
  h1 { font-size: 14pt; margin: 0 0 6px; }
  .head { margin: 0 0 12px; }
  .head b { display: inline-block; min-width: 64px; }
  table { border-collapse: collapse; width: 100%; }
  th, td { border: 1px solid #bbb; padding: 3px 5px; }
  th { background: #f2f2f2; font-weight: 700; }
  td.n, th.n { text-align: center; white-space: nowrap; }
  tr.totals td { font-weight: 700; background: #f7f7f7; }
  .type { font-weight: 400; font-size: 8pt; color: #555; }
</style>
</head>
<body>
<h1>{{ title }}</h1>
<div class="head">
  {% for label, value in header %}<div><b>{{ label }}:</b> {{ value }}</div>{% endfor %}
</div>
<table>
  <thead>
    <tr>
      <th>Crew Names</th><th>Notes</th><th>Reservation Number</th>
      {% for c in cols %}<th class="n">{{ c.weekday }} {{ c.date }}<br><span class="type">{{ c.type }}</span></th>{% endfor %}
      <th class="n">TOTAL</th>
    </tr>
  </thead>
  <tbody>
    {% for r in rows %}
    <tr>
      <td>{{ r.name }}</td><td>{{ r.notes }}</td><td>{{ r.reservation }}</td>
      {% for c in cols %}<td class="n">{{ r.cells.get(c.key, "") }}</td>{% endfor %}
      <td class="n">{{ r.total }}</td>
    </tr>
    {% endfor %}
    <tr class="totals">
      <td>TOTALS</td><td></td><td></td>
      {% for c in cols %}<td class="n">{{ totals.get(c.key, 0) }}</td>{% endfor %}
      <td class="n">{{ total }}</td>
    </tr>
    {% if breakfasts %}
    <tr class="totals">
      <td>Hotel Breakfast Count</td><td></td><td></td>
      {% for c in cols %}<td class="n">{{ breakfasts.get(c.key, 0) }}</td>{% endfor %}
      <td></td>
    </tr>
    {% endif %}
  </tbody>
</table>
</body>
</html>
